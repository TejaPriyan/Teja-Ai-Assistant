# ============================================================
# TEJA AI — Environment Variables
# ============================================================
# Copy this file to .env and fill in your keys.
# NEVER commit your .env file to git!
# ============================================================

# Required: Groq API Key
# Get yours free at https://console.groq.com/keys
VITE_GROQ_API_KEY=gsk_your_groq_key_here

# Optional: OpenRouter API Key
# Required only for screen vision features (analyze_and_click, capture_screen)
# Get yours free at https://openrouter.ai
VITE_OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here
